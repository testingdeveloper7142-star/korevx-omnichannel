# SERVER
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# DATABASE (PostgreSQL)
DATABASE_URL="postgresql://korevx_user:korevx_password@localhost:5432/korevx_omnichannel?schema=public"

# REDIS & QUEUES
REDIS_HOST=localhost
REDIS_PORT=6379

# AUTH & SECURITY
JWT_SECRET="korevx_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRATION="7d"

# META (Facebook & Instagram Graph API)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="korevx_webhook_verify_token_secure"

# TIKTOK FOR BUSINESS
TIKTOK_APP_ID="your_tiktok_app_id"
TIKTOK_APP_SECRET="your_tiktok_app_secret"
TIKTOK_WEBHOOK_VERIFY_TOKEN="korevx_tiktok_verify_token_secure"
